{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unae-dtos:message:1.1",
  "title": "UNAE-DTOS Integration Message v1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "schema_version": {
      "const": "1"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "enum": [
        "OPERATION_REQUEST",
        "EFFECT_DISPATCHED",
        "EFFECT_RESULT",
        "RECONCILIATION_RESULT",
        "RECOVERY_NOTICE"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "cognitive_cycle_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "operation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "effect_intent_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "effect_attempt_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "authority_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "fencing_token": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "REQUESTED",
        "DISPATCHED",
        "CONFIRMED",
        "REJECTED",
        "PARTIAL",
        "UNKNOWN",
        "SUCCEEDED",
        "FAILED",
        "NOT_FOUND",
        "RECOVERY_REQUIRED",
        null
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "required": [
    "contract_version",
    "schema_version",
    "message_id",
    "message_type",
    "correlation_id",
    "evidence_refs",
    "created_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "OPERATION_REQUEST"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "operation_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "EFFECT_DISPATCHED"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "effect_intent_id": {
            "type": "string",
            "minLength": 1
          },
          "effect_attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "fencing_token": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "operation_id",
          "effect_intent_id",
          "effect_attempt_id",
          "idempotency_key",
          "fencing_token"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "EFFECT_RESULT"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "effect_intent_id": {
            "type": "string",
            "minLength": 1
          },
          "effect_attempt_id": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "operation_id",
          "effect_intent_id",
          "effect_attempt_id",
          "idempotency_key",
          "result",
          "evidence_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "RECONCILIATION_RESULT"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "operation_id",
          "result",
          "evidence_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "RECOVERY_NOTICE"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "result",
          "evidence_refs"
        ]
      }
    }
  ]
}